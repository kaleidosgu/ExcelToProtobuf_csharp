{
  "SourceLanguage": "zh-CN",
  "TargetLanguages": [
    "en-US",
    "ja-JP",
    "ko-KR"
  ],
  "DefaultTranslationSourceLanguage": "zh-CN",
  "LanguageSourceLanguages": {
    "en-US": "zh-CN",
    "ja-JP": "zh-CN",
    "ko-KR": "zh-CN"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434/api/generate",
    "Model": "translategemma:12b",
    "TimeoutSeconds": 300,
    "BatchSize": 16,
    "MaxRetries": 2,
    "NumPredict": 4096,
    "Temperature": 0.0,
    "TopP": 0.9,
    "SystemPrompt": "You are a professional game/localization translator. Keep placeholders, markup, escape sequences, numbers, and punctuation semantics unchanged."
  },
  "TranslationMemory": {
    "Directory": "translation-memory",
    "Enabled": true,
    "SaveIndented": true
  },
  "TargetFiles": [
    {
      "SourceFilePath": "localization.json",
      "OutputDirectory": "output",
      "OutputFileNamePattern": "localization.json",
      "WriteSourceLanguageCopy": true
    }
  ]
}
