{
  "SourceLanguage": "zh-CN",
  "TargetLanguages": [
    "en",
    "ja",
    "ko"
  ],
  "Google": {
    "ApiKey": "",
    "OAuthAccessToken": "",
    "Endpoint": "https://translation.googleapis.com/language/translate/v2",
    "TimeoutSeconds": 60,
    "BatchSize": 64
  },
  "TranslationMemory": {
    "Directory": "translation-memory",
    "Enabled": true,
    "SaveIndented": true
  },
  "TargetFiles": [
    {
      "SourceFilePath": "localization.zh-CN.json",
      "OutputDirectory": "output",
      "OutputFileNamePattern": "{name}.{language}{ext}",
      "WriteSourceLanguageCopy": true
    }
  ]
}
